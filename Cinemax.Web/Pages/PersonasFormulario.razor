@page "/personas/nueva"
@page "/personas/editar/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using System.Text.Json
@using Cinemax.Shared.DTO.Comun
@using Cinemax.Shared.DTO.Persona.Request
@using Cinemax.Shared.DTO.Persona.Response
@using Cinemax.Web.Components
@using Cinemax.Web.Services

@inject PersonaService PersonaService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@Titulo</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-6">

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       Title="Volver al listado"
                       OnClick="Volver" />

        <MudText Typo="Typo.h4">@Titulo</MudText>
    </MudStack>

    @if (cargando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        <MudText Class="mt-2">Cargando datos...</MudText>
    }
    else if (!string.IsNullOrWhiteSpace(errorCarga))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorCarga</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Volver">Volver al listado</MudButton>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-5">
            <MudStack Spacing="3">

                <MudTextField T="string"
                              Label="Nombre"
                              @bind-Value="nombre"
                              MaxLength="200"
                              Variant="Variant.Outlined" />

                <MudDivider Class="my-1" />

                @if (!_idActual.HasValue)
                {
                    <MudText Typo="Typo.caption">La foto se sube después de crear la persona.</MudText>
                }

                <SelectorImagen Titulo="Foto"
                                Actual="imagenActual"
                                @bind-Archivo="archivo"
                                Ancho="160"
                                Alto="160" />

                @if (!string.IsNullOrWhiteSpace(errorValidacion))
                {
                    <MudAlert Severity="Severity.Warning">@errorValidacion</MudAlert>
                }

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <MudAlert Severity="Severity.Error">@error</MudAlert>
                }

                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                    <MudButton Variant="Variant.Outlined" Disabled="@guardando" OnClick="Volver">
                        Cancelar
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@guardando"
                               OnClick="Guardar">
                        @(guardando
                            ? "Guardando..."
                            : _idActual.HasValue ? "Guardar cambios" : "Crear persona")
                    </MudButton>
                </MudStack>

            </MudStack>
        </MudPaper>
    }

</MudContainer>

@code {
    [Parameter]
    public int? Id { get; set; }

    // Id de la persona que se está editando. En una creación se completa apenas el backend la crea,
    // así un reintento (por ejemplo, si falló la subida de la foto) actualiza en vez de duplicar.
    private int? _idActual;

    private string Titulo => Id.HasValue ? "Modificar persona" : "Nueva persona";

    private string nombre = string.Empty;
    private ImagenResponse? imagenActual;
    private IBrowserFile? archivo;

    private bool cargando = true;
    private bool guardando;
    private string? errorCarga;
    private string? error;
    private string? errorValidacion;

    protected override async Task OnInitializedAsync()
    {
        _idActual = Id;

        try
        {
            if (Id.HasValue)
            {
                PersonaResponse persona = await PersonaService.ObtenerPersona(Id.Value);

                nombre = persona.Nombre;
                imagenActual = persona.Imagen;
            }
        }
        catch (Exception e) when (EsErrorEsperado(e))
        {
            errorCarga = Mensaje(e, "No se pudo cargar la persona. Verificá tu sesión y la conexión con el backend.");
        }
        finally
        {
            cargando = false;
        }
    }

    private string? Validar()
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "El nombre es obligatorio.";
        if (nombre.Trim().Length > 200) return "El nombre no puede superar 200 caracteres.";
        return null;
    }

    private async Task Guardar()
    {
        if (guardando) return;

        error = null;
        errorValidacion = Validar();

        if (errorValidacion is not null) return;

        guardando = true;

        try
        {
            if (_idActual.HasValue)
            {
                await PersonaService.Actualizar(_idActual.Value, new ActualizarPersonaRequest(nombre.Trim()));
            }
            else
            {
                PersonaResponse creada = await PersonaService.Crear(new CrearPersonaRequest(nombre.Trim()));
                _idActual = creada.Id;
            }
        }
        catch (Exception e) when (EsErrorEsperado(e))
        {
            error = Mensaje(e, "No se pudo guardar la persona. Verificá los datos y tu sesión.");
            guardando = false;
            return;
        }

        // La persona ya está guardada: ahora se sube la foto elegida.
        if (archivo is not null)
        {
            try
            {
                imagenActual = await PersonaService.SubirImagen(_idActual!.Value, archivo);
                archivo = null;
            }
            catch (Exception e) when (EsErrorEsperado(e))
            {
                error = $"La persona se guardó, pero no se pudo subir la foto ({Mensaje(e, "error de conexión")}). " +
                        "Volvé a elegir el archivo y guardá de nuevo.";
                guardando = false;
                return;
            }
        }

        guardando = false;

        Snackbar.Add(Id.HasValue ? "Persona modificada." : "Persona guardada.", Severity.Success);
        Navigation.NavigateTo("/personas");
    }

    private static bool EsErrorEsperado(Exception e) =>
        e is HttpRequestException or InvalidOperationException or JsonException;

    private static string Mensaje(Exception e, string porDefecto) => e switch
    {
        InvalidOperationException => e.Message,
        JsonException => "El servidor devolvió una respuesta inválida.",
        _ => porDefecto
    };

    private void Volver() => Navigation.NavigateTo("/personas");
}
