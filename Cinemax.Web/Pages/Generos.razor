@page "/generos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using Cinemax.Shared.DTO.Genero.Request
@using Cinemax.Shared.DTO.Genero.Response
@using Cinemax.Web.Services
@inject GeneroService GeneroService
@inject ISnackbar Snackbar

<PageTitle>Géneros</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5">Géneros</MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_ocupado" OnClick="Nuevo">
            Nuevo género
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }

        @if (_mostrarFormulario)
        {
            <MudPaper Class="pa-4">
                <MudForm @ref="_formulario" Disabled="_ocupado">
                    <MudStack Spacing="3">
                        @if (_idEdicion.HasValue)
                        {
                            <MudText Typo="Typo.h6">Editar género</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">Nuevo género</MudText>
                        }

                        <MudTextField T="string" Label="Nombre"
                                      @bind-Value="_nombre"
                                      Required="true"
                                      RequiredError="Ingresá un nombre."
                                      MaxLength="100" />

                        <MudStack Row="true">
                            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="_ocupado" OnClick="Guardar">
                                Guardar
                            </MudButton>

                            <MudButton Disabled="_ocupado" OnClick="Cancelar">
                                Cancelar
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudForm>
            </MudPaper>
        }

        @if (_generoAEliminar is not null)
        {
            <MudAlert Severity="Severity.Warning">
                ¿Eliminar el género @_generoAEliminar.Nombre?

                <MudButton Color="Color.Error" Disabled="_ocupado" OnClick="Eliminar">
                    Eliminar
                </MudButton>

                <MudButton Disabled="_ocupado" OnClick="CancelarEliminacion">
                    Cancelar
                </MudButton>
            </MudAlert>
        }

        <MudTable T="GeneroResponse" Items="_generos"
                  Loading="_ocupado" Hover="true" RowsPerPage="10">
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>

                <MudTd DataLabel="Acciones">
                    <MudButton Disabled="_ocupado" OnClick="@(() => Editar(context))">
                        Editar
                    </MudButton>

                    <MudButton Color="Color.Error" Disabled="_ocupado"
                               OnClick="@(() => ConfirmarEliminacion(context))">
                        Eliminar
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No hay géneros.</MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudStack>
</MudContainer>

@code {
    private List<GeneroResponse> _generos = new();
    private GeneroResponse? _generoAEliminar;
    private MudForm _formulario = null!;
    private int? _idEdicion;
    private string _nombre = string.Empty;
    private string? _error;
    private bool _mostrarFormulario;
    private bool _ocupado;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        _ocupado = true;
        _error = null;

        try
        {
            _generos = await GeneroService.ObtenerGeneros();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar los géneros.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Nuevo()
    {
        _idEdicion = null;
        _nombre = string.Empty;
        _generoAEliminar = null;
        _error = null;
        _mostrarFormulario = true;
    }

    private void Editar(GeneroResponse genero)
    {
        _idEdicion = genero.Id;
        _nombre = genero.Nombre;
        _generoAEliminar = null;
        _error = null;
        _mostrarFormulario = true;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
    }

    private void ConfirmarEliminacion(GeneroResponse genero)
    {
        _generoAEliminar = genero;
        _mostrarFormulario = false;
        _error = null;
    }

    private void CancelarEliminacion()
    {
        _generoAEliminar = null;
    }

    private async Task Guardar()
    {
        if (_ocupado)
            return;

        await _formulario.ValidateAsync();

        if (!_formulario.IsValid)
            return;

        _ocupado = true;
        _error = null;

        try
        {
            if (_idEdicion.HasValue)
            {
                await GeneroService.Actualizar(_idEdicion.Value, new ActualizarGeneroRequest(_nombre.Trim()));
            }
            else
            {
                await GeneroService.Crear(new CrearGeneroRequest(_nombre.Trim()));
            }

            _mostrarFormulario = false;
            Snackbar.Add("Género guardado.", Severity.Success);

            _generos = await GeneroService.ObtenerGeneros();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo completar la operación.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Eliminar()
    {
        if (_generoAEliminar is null || _ocupado)
            return;

        int id = _generoAEliminar.Id;

        _ocupado = true;
        _error = null;

        try
        {
            await GeneroService.Eliminar(id);

            _generoAEliminar = null;
            Snackbar.Add("Género eliminado.", Severity.Success);

            _generos = await GeneroService.ObtenerGeneros();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo completar la operación.";
        }
        catch (InvalidOperationException e)
        {
            // Por ejemplo, si el género está en uso por alguna película, se muestra el mensaje del backend.
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
