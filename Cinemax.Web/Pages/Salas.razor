@page "/salas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@using Cinemax.Shared.DTO.Sala.Request
@using Cinemax.Shared.DTO.Sala.Response
@using Cinemax.Web.Components
@using Cinemax.Web.Services
@inject SalaService SalaService
@inject ISnackbar Snackbar

<PageTitle>Salas</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5">Salas</MudText>

        <MudText Typo="Typo.body2" Color="Color.Primary">
            Las butacas de cada sala se generan solas con la configuración de la sala del sistema.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_ocupado" OnClick="Nueva">
            Nueva sala
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }

        @if (_mostrarFormulario)
        {
            <MudPaper Class="pa-4">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6">@(_idEdicion.HasValue ? "Editar sala" : "Nueva sala")</MudText>

                    <MudNumericField T="int"
                                     Label="Número de sala"
                                     @bind-Value="_numero"
                                     Min="1"
                                     Variant="Variant.Outlined" />

                    <MudStack Row="true">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                   Disabled="_ocupado" OnClick="Guardar">
                            Guardar
                        </MudButton>

                        <MudButton Disabled="_ocupado" OnClick="Cancelar">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        @if (_salaAEliminar is not null)
        {
            <MudAlert Severity="Severity.Warning">
                ¿Eliminar la sala @_salaAEliminar.Numero?

                <MudButton Color="Color.Error" Disabled="_ocupado" OnClick="Eliminar">
                    Eliminar
                </MudButton>

                <MudButton Disabled="_ocupado" OnClick="CancelarEliminacion">
                    Cancelar
                </MudButton>
            </MudAlert>
        }

        <MudTable T="SalaResponse" Items="_salas"
                  Loading="_ocupado" Hover="true" RowsPerPage="10">
            <HeaderContent>
                <MudTh>Número</MudTh>
                <MudTh>Butacas</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Número">Sala @context.Numero</MudTd>
                <MudTd DataLabel="Butacas">@context.CantidadButacas</MudTd>

                <MudTd DataLabel="Acciones">
                    <MudButton Disabled="_ocupado" OnClick="@(() => VerMapa(context))">
                        Ver mapa
                    </MudButton>

                    <MudButton Disabled="_ocupado" OnClick="@(() => Editar(context))">
                        Editar
                    </MudButton>

                    <MudButton Color="Color.Error" Disabled="_ocupado"
                               OnClick="@(() => ConfirmarEliminacion(context))">
                        Eliminar
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>No hay salas.</MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>

        @if (_mapa is not null)
        {
            <MudPaper Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Mapa de la sala @_mapa.NumeroSala</MudText>
                    <MudButton OnClick="CerrarMapa">Cerrar</MudButton>
                </MudStack>

                <MapaSalaVista Mapa="_mapa" />
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private List<SalaResponse> _salas = new();
    private SalaResponse? _salaAEliminar;
    private MapaSalaResponse? _mapa;
    private int? _idEdicion;
    private int _numero = 1;
    private string? _error;
    private bool _mostrarFormulario;
    private bool _ocupado;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        _ocupado = true;
        _error = null;

        try
        {
            _salas = await SalaService.ObtenerSalas();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar las salas.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void Nueva()
    {
        _idEdicion = null;
        // Se sugiere el número siguiente al mayor existente.
        _numero = _salas.Count == 0 ? 1 : _salas.Max(s => s.Numero) + 1;
        _salaAEliminar = null;
        _error = null;
        _mostrarFormulario = true;
    }

    private void Editar(SalaResponse sala)
    {
        _idEdicion = sala.Id;
        _numero = sala.Numero;
        _salaAEliminar = null;
        _error = null;
        _mostrarFormulario = true;
    }

    private void Cancelar()
    {
        _mostrarFormulario = false;
    }

    private void ConfirmarEliminacion(SalaResponse sala)
    {
        _salaAEliminar = sala;
        _mostrarFormulario = false;
        _error = null;
    }

    private void CancelarEliminacion()
    {
        _salaAEliminar = null;
    }

    private void CerrarMapa()
    {
        _mapa = null;
    }

    private async Task VerMapa(SalaResponse sala)
    {
        _ocupado = true;
        _error = null;

        try
        {
            _mapa = await SalaService.ObtenerMapa(sala.Id);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo cargar el mapa de la sala.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Guardar()
    {
        if (_ocupado)
            return;

        if (_numero <= 0)
        {
            _error = "El número de sala debe ser mayor a cero.";
            return;
        }

        _ocupado = true;
        _error = null;

        try
        {
            if (_idEdicion.HasValue)
            {
                await SalaService.Actualizar(_idEdicion.Value, new ActualizarSalaRequest(_numero));
            }
            else
            {
                await SalaService.Crear(new CrearSalaRequest(_numero));
            }

            _mostrarFormulario = false;
            Snackbar.Add("Sala guardada.", Severity.Success);

            _salas = await SalaService.ObtenerSalas();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo completar la operación.";
        }
        catch (InvalidOperationException e)
        {
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }

    private async Task Eliminar()
    {
        if (_salaAEliminar is null || _ocupado)
            return;

        int id = _salaAEliminar.Id;

        _ocupado = true;
        _error = null;

        try
        {
            await SalaService.Eliminar(id);

            if (_mapa?.SalaId == id) _mapa = null;

            _salaAEliminar = null;
            Snackbar.Add("Sala eliminada.", Severity.Success);

            _salas = await SalaService.ObtenerSalas();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo completar la operación.";
        }
        catch (InvalidOperationException e)
        {
            // Por ejemplo, si la sala tiene funciones programadas, se muestra el mensaje del backend.
            _error = e.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
