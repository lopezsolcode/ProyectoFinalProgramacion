@inherits PosComponentBase

<MudStack Spacing="3">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="@(_vista == Vista.Snacks ? Variant.Filled : Variant.Outlined)"
                   OnClick="@(() => CambiarVista(Vista.Snacks))">Snacks</MudButton>
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="@(_vista == Vista.Combos ? Variant.Filled : Variant.Outlined)"
                   OnClick="@(() => CambiarVista(Vista.Combos))">Combos</MudButton>

        <MudTextField T="string"
                      @bind-Value="_buscar"
                      Label="Buscar por nombre"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="Buscar"
                      Style="min-width: 220px; flex: 1;" />
    </MudStack>

    @if (_cargando)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton Color="Color.Primary" OnClick="Cargar">Reintentar</MudButton>
    }
    else if (!_cargando && CantidadMostrada == 0)
    {
        <MudAlert Severity="Severity.Info">No se encontró nada con ese criterio.</MudAlert>
    }
    else if (_vista == Vista.Snacks)
    {
        <MudGrid Spacing="2">
            @foreach (SnackCatalogoResponse s in _snacks)
            {
                <MudItem @key="s.Id" xs="6" sm="4" lg="3">
                    <div @onclick="() => AgregarSnack(s)" style="@EstiloTarjeta(s.Disponible)">
                        <MudCard Style="@(s.Disponible ? "height: 100%;" : "height: 100%; opacity: 0.55;")">
                            @if (s.Imagen is not null)
                            {
                                <MudCardMedia Image="@s.Imagen.Url" Height="110" />
                            }
                            else
                            {
                                <div class="d-flex align-center justify-center mud-background-gray" style="height: 110px;" aria-label="Sin imagen">
                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
                                </div>
                            }
                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.subtitle2">@s.Nombre</MudText>
                                <MudText Typo="Typo.caption" Class="d-block">@s.DescripcionUnidad</MudText>
                                @if (!s.Disponible)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Error">Sin stock</MudText>
                                }
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@PosFormato.Moneda(s.Precio)</MudText>
                                @if (Estado.CantidadDe(s.Id, null) > 0)
                                {
                                    <MudText Typo="Typo.caption">En la venta: @Estado.CantidadDe(s.Id, null)</MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (ComboResponse c in _combos)
            {
                <MudItem @key="c.Id" xs="6" sm="4" lg="3">
                    <div @onclick="() => AgregarCombo(c)" style="@EstiloTarjeta(c.Disponible)">
                        <MudCard Style="@(c.Disponible ? "height: 100%;" : "height: 100%; opacity: 0.55;")">
                            @if (c.Imagen is not null)
                            {
                                <MudCardMedia Image="@c.Imagen.Url" Height="110" />
                            }
                            else
                            {
                                <div class="d-flex align-center justify-center mud-background-gray" style="height: 110px;" aria-label="Sin imagen">
                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
                                </div>
                            }
                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.subtitle2">@c.Nombre</MudText>
                                <MudText Typo="Typo.caption" Class="d-block">
                                    @string.Join(", ", c.Items.Select(i => $"{i.Cantidad} x {i.SnackNombre}"))
                                </MudText>
                                @if (!c.Disponible)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Error">Sin stock</MudText>
                                }
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">@PosFormato.Moneda(c.Precio)</MudText>
                                @if (Estado.CantidadDe(null, c.Id) > 0)
                                {
                                    <MudText Typo="Typo.caption">En la venta: @Estado.CantidadDe(null, c.Id)</MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }

    @if (_totalPaginas > 1)
    {
        <MudPagination Count="_totalPaginas" Selected="_pagina" SelectedChanged="CambiarPagina" Color="Color.Primary" />
    }

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        @if (Estado.PuedeIr(PasoPos.Butacas))
        {
            <MudButton Variant="Variant.Text" OnClick="@(() => Estado.IrA(PasoPos.Butacas))">Volver a las butacas</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@(() => Estado.IrA(PasoPos.Pelicula))">Agregar entradas</MudButton>
        }
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!Estado.HayItems)"
                   OnClick="@(() => Estado.IrA(PasoPos.Cobro))">
            Ir al cobro
        </MudButton>
    </MudStack>
</MudStack>

@code {
    private enum Vista { Snacks, Combos }

    private Vista _vista = Vista.Snacks;
    private List<SnackCatalogoResponse> _snacks = new();
    private List<ComboResponse> _combos = new();
    private string? _buscar;
    private string? _busquedaAplicada;
    private string? _error;
    private bool _cargando;
    private int _pagina = 1;
    private int _totalPaginas;
    private int _solicitud;

    private int CantidadMostrada => _vista == Vista.Snacks ? _snacks.Count : _combos.Count;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        int solicitud = ++_solicitud;
        _cargando = true;
        _error = null;

        try
        {
            if (_vista == Vista.Snacks)
            {
                PaginadoResponseDto<SnackCatalogoResponse> r = await Api.ObtenerSnacks(_pagina, _busquedaAplicada);
                if (solicitud != _solicitud) return;
                _snacks = r.Datos;
                _pagina = r.NumeroPagina;
                _totalPaginas = r.TotalPaginas;
            }
            else
            {
                PaginadoResponseDto<ComboResponse> r = await Api.ObtenerCombos(_pagina, _busquedaAplicada);
                if (solicitud != _solicitud) return;
                _combos = r.Datos;
                _pagina = r.NumeroPagina;
                _totalPaginas = r.TotalPaginas;
            }
        }
        catch (Exception e) when (EsErrorEsperado(e))
        {
            if (solicitud == _solicitud)
                _error = Mensaje(e, "No se pudo cargar el catálogo. Verificá la conexión con el servidor.");
        }
        finally
        {
            if (solicitud == _solicitud) _cargando = false;
        }
    }

    private async Task CambiarVista(Vista vista)
    {
        if (_vista == vista) return;

        _vista = vista;
        _pagina = 1;
        await Cargar();
    }

    private async Task Buscar(string? texto)
    {
        _busquedaAplicada = texto?.Trim();
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarPagina(int pagina)
    {
        _pagina = pagina;
        await Cargar();
    }

    private void AgregarSnack(SnackCatalogoResponse s)
    {
        if (s.Disponible) Estado.AgregarSnack(s.Id, s.Nombre, s.Precio);
    }

    private void AgregarCombo(ComboResponse c)
    {
        if (c.Disponible) Estado.AgregarCombo(c.Id, c.Nombre, c.Precio);
    }

    private static string EstiloTarjeta(bool disponible) =>
        $"height: 100%; cursor: {(disponible ? "pointer" : "not-allowed")};";
}
