@inherits PosComponentBase

<MudStack Spacing="3">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField T="string"
                      @bind-Value="_buscar"
                      Label="Buscar película"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="Buscar"
                      Style="min-width: 240px; flex: 1;" />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Fastfood"
                   OnClick="Estado.SoloSnacks">
            Vender solo snacks
        </MudButton>
    </MudStack>

    @if (_cargando)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton Color="Color.Primary" OnClick="Cargar">Reintentar</MudButton>
    }
    else if (!_cargando && _peliculas.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No hay películas en cartelera con ese criterio.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (PeliculaCatalogoResponse p in _peliculas)
            {
                <MudItem @key="p.Id" xs="6" sm="4" lg="3">
                    <div @onclick="() => Estado.ElegirPelicula(p)" style="cursor: pointer; height: 100%;">
                        <MudCard Style="height: 100%;">
                            @if (p.Poster is not null)
                            {
                                <MudCardMedia Image="@p.Poster.Url" Height="220" />
                            }
                            else
                            {
                                <div class="d-flex align-center justify-center mud-background-gray"
                                     style="height: 220px;"
                                     aria-label="Película sin póster">
                                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" />
                                </div>
                            }

                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.subtitle2">@p.Titulo</MudText>
                                <MudText Typo="Typo.caption" Class="d-block">@p.Clasificacion, @p.DuracionMinutos min</MudText>
                                <MudText Typo="Typo.caption" Class="d-block">@string.Join(", ", p.Generos)</MudText>
                            </MudCardContent>
                        </MudCard>
                    </div>
                </MudItem>
            }
        </MudGrid>

        @if (_totalPaginas > 1)
        {
            <MudPagination Count="_totalPaginas" Selected="_pagina" SelectedChanged="CambiarPagina" Color="Color.Primary" />
        }
    }
</MudStack>

@code {
    private List<PeliculaCatalogoResponse> _peliculas = new();
    private string? _buscar;
    private string? _busquedaAplicada;
    private string? _error;
    private bool _cargando;
    private int _pagina = 1;
    private int _totalPaginas;
    private int _solicitud;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        int solicitud = ++_solicitud;
        _cargando = true;
        _error = null;

        try
        {
            PaginadoResponseDto<PeliculaCatalogoResponse> r = await Api.ObtenerCartelera(_pagina, _busquedaAplicada);

            if (solicitud != _solicitud) return;

            _peliculas = r.Datos;
            _pagina = r.NumeroPagina;
            _totalPaginas = r.TotalPaginas;
        }
        catch (Exception e) when (EsErrorEsperado(e))
        {
            if (solicitud == _solicitud)
                _error = Mensaje(e, "No se pudo cargar la cartelera. Verificá la conexión con el servidor.");
        }
        finally
        {
            if (solicitud == _solicitud) _cargando = false;
        }
    }

    private async Task Buscar(string? texto)
    {
        _busquedaAplicada = texto?.Trim();
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarPagina(int pagina)
    {
        _pagina = pagina;
        await Cargar();
    }
}
