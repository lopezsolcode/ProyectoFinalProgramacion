@inherits PosComponentBase

<MudStack Spacing="3">
    <MudText Typo="Typo.h6">Funciones de @Estado.Pelicula?.Titulo</MudText>

    <div class="d-flex gap-2 overflow-auto pb-1">
        @foreach (DateOnly dia in _dias)
        {
            <MudButton @key="dia"
                       Size="Size.Small"
                       Color="Color.Primary"
                       Style="white-space: nowrap;"
                       Variant="@(dia == _dia ? Variant.Filled : Variant.Outlined)"
                       OnClick="@(() => SeleccionarDia(dia))">
                @PosFormato.Dia(dia)
            </MudButton>
        }
    </div>

    @if (_cargando)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton Color="Color.Primary" OnClick="Cargar">Reintentar</MudButton>
    }
    else if (!_cargando && _funciones.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No quedan funciones para este día. Probá con otra fecha.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="2">
            @foreach (FuncionCatalogoResponse f in _funciones)
            {
                <MudItem @key="f.Id" xs="6" sm="4" md="3">
                    <MudButton FullWidth="true"
                               Color="Color.Primary"
                               Style="height: 100%; text-transform: none;"
                               Variant="@(Estado.Funcion?.Id == f.Id ? Variant.Filled : Variant.Outlined)"
                               OnClick="@(() => Estado.ElegirFuncion(f))">
                        <MudStack Spacing="0" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6" Color="Color.Inherit">@PosFormato.Hora(f.FechaHora)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">Sala @f.SalaNumero</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">@f.Formato, @f.Idioma</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Inherit">@PosFormato.Moneda(f.PrecioEntrada)</MudText>
                        </MudStack>
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    }

    <MudStack Row="true">
        <MudButton Variant="Variant.Text" OnClick="@(() => Estado.IrA(PasoPos.Pelicula))">Cambiar película</MudButton>
    </MudStack>
</MudStack>

@code {
    private const int DiasVisibles = 7;

    private readonly List<DateOnly> _dias = new();
    private List<FuncionCatalogoResponse> _funciones = new();
    private DateOnly _dia;
    private string? _error;
    private bool _cargando;
    private int _solicitud;

    protected override async Task OnInitializedAsync()
    {
        DateOnly hoy = PosService.HoyLocal();

        for (int i = 0; i < DiasVisibles; i++)
        {
            _dias.Add(hoy.AddDays(i));
        }

        _dia = hoy;
        await Cargar();
    }

    private async Task SeleccionarDia(DateOnly dia)
    {
        _dia = dia;
        await Cargar();
    }

    private async Task Cargar()
    {
        if (Estado.Pelicula is null) return;

        int solicitud = ++_solicitud;
        _cargando = true;
        _error = null;

        try
        {
            List<FuncionCatalogoResponse> funciones = await Api.ObtenerFuncionesDelDia(Estado.Pelicula.Id, _dia);

            if (solicitud != _solicitud) return;

            _funciones = funciones;
        }
        catch (Exception e) when (EsErrorEsperado(e))
        {
            if (solicitud == _solicitud)
                _error = Mensaje(e, "No se pudieron cargar las funciones. Verificá la conexión con el servidor.");
        }
        finally
        {
            if (solicitud == _solicitud) _cargando = false;
        }
    }
}
