@page "/mis-compras"
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Cinemax.Mobile.Services
@using Cinemax.Shared.DTO.Venta.Response
@using Cinemax.Shared.Enums
@attribute [Authorize(Roles = "Cliente")]
@inject ComprasService ComprasService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Mis compras</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Mis compras</MudText>

    @if (_cargando)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
        <MudButton OnClick="CargarCompras">Reintentar</MudButton>
    }
    else if (_compras.Count == 0)
    {
        <MudText>No tenés compras para mostrar.</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (VentaListadoResponse compra in _compras)
            {
                <MudCard @key="compra.Id">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Compra #@compra.Id</MudText>
                        <MudText Typo="Typo.body2">@Formato.DiaHora(compra.Fecha)</MudText>
                        <MudText Typo="Typo.body2">Estado: @Etiquetas.DeEstadoVenta(compra.Estado)</MudText>
                        <MudText Typo="Typo.body2">Total: @Formato.Moneda(compra.Total)</MudText>
                    </MudCardContent>

                    <MudCardActions>
                        @if (compra.Estado == EstadoVenta.Pendiente)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@(() => Navigation.NavigateTo($"/pago/{compra.Id}"))">
                                Retomar pago
                            </MudButton>
                        }
                        else if (compra.Estado == EstadoVenta.Confirmada)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                       Disabled="_descargando"
                                       OnClick="@(() => AbrirComprobante(compra.Id))">
                                Ver comprobante
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            }
        </MudStack>

        @if (_totalPaginas > 1)
        {
            <MudPagination Count="_totalPaginas"
                           Selected="_pagina"
                           SelectedChanged="CambiarPagina"
                           Color="Color.Primary"
                           Class="mt-3" />
        }
    }
</MudContainer>

@code {
    private List<VentaListadoResponse> _compras = new();
    private int _pagina = 1;
    private int _totalPaginas;
    private bool _cargando;
    private bool _descargando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CargarCompras();
    }

    private async Task CargarCompras()
    {
        if (_cargando) return;

        _cargando = true;
        _error = null;

        try
        {
            var resultado = await ComprasService.ObtenerMisCompras(_pagina);

            _compras = resultado.Datos;
            _pagina = resultado.NumeroPagina;
            _totalPaginas = resultado.TotalPaginas;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            _error = e is InvalidOperationException
                ? e.Message
                : "No se pudieron consultar tus compras. Intentá nuevamente.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AbrirComprobante(int ventaId)
    {
        if (_descargando) return;

        _descargando = true;

        try
        {
            if (!await ComprasService.AbrirComprobante(ventaId))
            {
                Snackbar.Add("No se pudo abrir el PDF. Comprobá que tengas una aplicación compatible.", Severity.Warning);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo descargar el comprobante. Intentá nuevamente.", Severity.Error);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _descargando = false;
        }
    }

    private async Task CambiarPagina(int pagina)
    {
        if (_cargando) return;

        _pagina = pagina;
        await CargarCompras();
    }
}
