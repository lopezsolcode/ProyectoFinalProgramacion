@page "/cartelera"
@page "/catalogo"
@using System.Text.Json
@using Cinemax.Mobile.Services
@using Cinemax.Shared.DTO.Paginado.Response
@using Cinemax.Shared.DTO.Pelicula.Response
@inject CatalogoService CatalogoService
@inject NavigationManager Navigation

<PageTitle>Cartelera</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h5" HtmlTag="h1">Cartelera</MudText>

            <AuthorizeView Roles="Cliente">
                <Authorized>
                    <MudButton Href="/carrito" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ShoppingCart">
                        Mi compra
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">
                        Iniciar sesión
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </MudStack>

        <MudTextField T="string"
                      @bind-Value="_buscar"
                      Label="Buscar película"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="350"
                      OnDebounceIntervalElapsed="Buscar" />

        @if (_cargando)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
            <MudButton OnClick="Cargar" Color="Color.Primary">Reintentar</MudButton>
        }
        else if (!_cargando && _peliculas.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No hay películas en cartelera con ese criterio.</MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (PeliculaCatalogoResponse p in _peliculas)
                {
                    <MudItem @key="p.Id" xs="6" sm="4" md="3">
                        <div @onclick='() => Navigation.NavigateTo($"/catalogo/{p.Id}")'
                             style="cursor: pointer; height: 100%;">
                            <MudCard Style="height: 100%;">
                                <ImagenRemota Url="@p.Poster?.Url" Alto="230" Alt="@p.Titulo" Icono="@Icons.Material.Filled.Movie" />

                                <MudCardContent Class="pa-3">
                                    <MudText Typo="Typo.subtitle2">@p.Titulo</MudText>
                                    <MudText Typo="Typo.caption" Class="d-block">
                                        @Etiquetas.DeClasificacion(p.Clasificacion), @p.DuracionMinutos min
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="d-block">@string.Join(", ", p.Generos)</MudText>
                                </MudCardContent>
                            </MudCard>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            @if (_totalPaginas > 1)
            {
                <MudPagination Count="_totalPaginas" Selected="_pagina" SelectedChanged="CambiarPagina" Color="Color.Primary" />
            }
        }
    </MudStack>
</MudContainer>

@code {
    private List<PeliculaCatalogoResponse> _peliculas = new();
    private string? _buscar;
    private string? _busquedaAplicada;
    private string? _error;
    private bool _cargando;
    private int _pagina = 1;
    private int _totalPaginas;
    private int _solicitud;

    protected override Task OnInitializedAsync() => Cargar();

    private async Task Cargar()
    {
        int solicitud = ++_solicitud;
        _cargando = true;
        _error = null;

        try
        {
            PaginadoResponseDto<PeliculaCatalogoResponse> r = await CatalogoService.ObtenerCartelera(_pagina, _busquedaAplicada);

            if (solicitud != _solicitud) return;

            _peliculas = r.Datos;
            _pagina = r.NumeroPagina;
            _totalPaginas = r.TotalPaginas;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            if (solicitud == _solicitud)
                _error = e is InvalidOperationException
                    ? e.Message
                    : "No se pudo cargar la cartelera. Verificá la conexión e intentá nuevamente.";
        }
        finally
        {
            if (solicitud == _solicitud) _cargando = false;
        }
    }

    private async Task Buscar(string? texto)
    {
        _busquedaAplicada = texto?.Trim();
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarPagina(int pagina)
    {
        _pagina = pagina;
        await Cargar();
    }
}
