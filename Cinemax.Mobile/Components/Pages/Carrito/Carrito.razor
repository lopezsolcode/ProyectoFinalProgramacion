@page "/carrito"
@using System.Net
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Cinemax.Mobile.Models
@using Cinemax.Mobile.Services
@using Cinemax.Shared.DTO.Funcion.Response
@using Cinemax.Shared.DTO.Venta.Request
@using Cinemax.Shared.DTO.Venta.Response
@using Cinemax.Shared.Enums
@attribute [Authorize(Roles = "Cliente")]
@inject CarritoService Compra
@inject CatalogoService CatalogoService
@inject ComprasService ComprasService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Mi compra</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4" Style="padding-bottom: 110px;">
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Mi compra</MudText>

    @if (_cargando)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }

        @if (_pendiente is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                <MudText>
                    Tenés una compra pendiente de pago (#@_pendiente.Id, @Formato.Moneda(_pendiente.Total)).
                    Pagala o cancelala antes de iniciar otra.
                </MudText>

                <MudStack Row="true" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_procesando"
                               OnClick="@(() => Navigation.NavigateTo($"/pago/{_pendiente.Id}"))">
                        Retomar pago
                    </MudButton>
                    <MudButton Disabled="_procesando" OnClick="CancelarPendiente">Cancelar esa compra</MudButton>
                </MudStack>
            </MudAlert>
        }

        @if (!Compra.TieneEntradas)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Tu compra todavía no tiene entradas. Elegí una película y una función para empezar.
            </MudAlert>
            <MudButton Href="/cartelera" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                Ver cartelera
            </MudButton>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle1">@Compra.Carrito.Pelicula?.Titulo</MudText>
                <MudText Typo="Typo.body2">
                    @Formato.DiaHora(Compra.Carrito.Funcion!.FechaHoraUtc), Sala @Compra.Carrito.Funcion.SalaNumero,
                    @Etiquetas.DeFormato(Compra.Carrito.Funcion.Formato), @Etiquetas.DeIdioma(Compra.Carrito.Funcion.Idioma)
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="mt-3">Entradas (@Compra.Carrito.Butacas.Count)</MudText>

                @foreach (ButacaCarrito b in Compra.Carrito.Butacas.OrderBy(x => x.Fila).ThenBy(x => x.Numero))
                {
                    <MudStack @key="b.Id" Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">Butaca @b.Etiqueta</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2">@Formato.Moneda(Compra.Carrito.Funcion.PrecioEntrada)</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="_procesando"
                                           Title="Quitar butaca"
                                           OnClick="@(() => Compra.DescartarButacas(new[] { b.Id }))" />
                        </MudStack>
                    </MudStack>
                }

                <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2"
                           OnClick="@(() => Navigation.NavigateTo($"/butacas/{Compra.Carrito.Funcion.Id}"))">
                    Cambiar butacas
                </MudButton>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.subtitle2">Snacks y combos</MudText>

                @if (Compra.Carrito.Lineas.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="my-2">No agregaste nada para comer.</MudText>
                }

                @foreach (LineaCarrito l in Compra.Carrito.Lineas)
                {
                    <div @key="l" class="mb-2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2">@l.Nombre</MudText>
                            <MudText Typo="Typo.body2">@Formato.Moneda(l.Subtotal)</MudText>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="_procesando"
                                           OnClick="@(() => Compra.CambiarCantidad(l.SnackId, l.ComboId, -1))" />
                            <MudText Typo="Typo.body2">@l.Cantidad</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                           Disabled="@(_procesando || l.Cantidad >= CarritoService.MaxCantidadPorItem)"
                                           OnClick="@(() => Compra.CambiarCantidad(l.SnackId, l.ComboId, 1))" />
                        </MudStack>
                    </div>
                }

                <MudButton Variant="Variant.Text" Size="Size.Small" Href="/snacks">
                    @(Compra.Carrito.Lineas.Count == 0 ? "Agregar snacks" : "Agregar más")
                </MudButton>
            </MudPaper>

            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Entradas</MudText>
                <MudText Typo="Typo.body2">@Formato.Moneda(Compra.TotalEntradas)</MudText>
            </MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">Snacks y combos</MudText>
                <MudText Typo="Typo.body2">@Formato.Moneda(Compra.TotalSnacks)</MudText>
            </MudStack>

            <MudText Typo="Typo.caption" Class="d-block mt-3">
                Al continuar reservamos tus butacas por unos minutos hasta que completes el pago.
            </MudText>
        }
    }
</MudContainer>

@if (!_cargando && Compra.TieneEntradas)
{
    <BarraInferior Titulo="Total"
                   Valor="@Formato.Moneda(Compra.Total)"
                   TextoBoton="@(_procesando ? "Procesando..." : "Continuar al pago")"
                   Deshabilitado="@(_procesando || _pendiente is not null)"
                   OnClick="Continuar" />
}

@code {
    private VentaListadoResponse? _pendiente;
    private bool _cargando = true;
    private bool _procesando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Compra.Inicializar();
            await CargarPendiente();
            await Validar();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            _error = e is InvalidOperationException
                ? e.Message
                : "No se pudo consultar tu compra. Verificá la conexión e intentá nuevamente.";
        }
        finally
        {
            _cargando = false;
        }
    }

    // Busca una compra pendiente de pago: el backend solo permite una a la vez.
    private async Task CargarPendiente()
    {
        var resultado = await ComprasService.ObtenerMisCompras(1, EstadoVenta.Pendiente);
        _pendiente = resultado.Datos.FirstOrDefault();
    }

    // Las butacas no se reservan hasta pagar: se confirma que la función siga vigente y las butacas libres.
    private async Task Validar()
    {
        if (!Compra.TieneEntradas) return;

        int funcionId = Compra.Carrito.Funcion!.Id;

        try
        {
            MapaFuncionResponse mapa = await CatalogoService.ObtenerMapa(funcionId);

            if (mapa.FechaHora <= DateTime.UtcNow)
            {
                await Compra.DescartarEntradas();
                Snackbar.Add("La función que elegiste ya comenzó. Elegí otra.", Severity.Warning);
                return;
            }

            List<int> ocupadas = Compra.Carrito.Butacas
                .Where(s => mapa.Butacas.Any(b => b.Id == s.Id && b.Ocupada))
                .Select(s => s.Id)
                .ToList();

            if (ocupadas.Count > 0)
            {
                await Compra.DescartarButacas(ocupadas);
                Snackbar.Add("Algunas butacas ya no están disponibles y se quitaron de tu compra.", Severity.Warning);
            }
        }
        catch (ApiException e) when (e.Codigo == HttpStatusCode.NotFound)
        {
            await Compra.DescartarEntradas();
            Snackbar.Add("La función que elegiste ya no está disponible. Elegí otra.", Severity.Warning);
        }
    }

    private async Task Continuar()
    {
        if (_procesando || !Compra.TieneEntradas) return;

        _procesando = true;

        try
        {
            CrearCompraOnlineRequest request = new(
                Compra.Carrito.Funcion!.Id,
                Compra.Carrito.Butacas.Select(b => b.Id).ToList(),
                Compra.Carrito.Lineas
                    .Select(l => new VentaSnackItemRequest(l.SnackId, l.ComboId, l.Cantidad))
                    .ToList());

            VentaResponse venta = await ComprasService.CrearCompraOnline(request);

            Navigation.NavigateTo($"/pago/{venta.Id}");
        }
        catch (InvalidOperationException e)
        {
            // Butaca ocupada, falta de stock o compra pendiente: se muestra el mensaje y se refresca el estado.
            Snackbar.Add(e.Message, Severity.Error);
            await Refrescar();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task CancelarPendiente()
    {
        if (_pendiente is null || _procesando) return;

        _procesando = true;

        try
        {
            await ComprasService.Cancelar(_pendiente.Id);
            _pendiente = null;
            Snackbar.Add("Cancelaste la compra pendiente.", Severity.Success);
        }
        catch (InvalidOperationException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
            await Refrescar();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task Refrescar()
    {
        try
        {
            await CargarPendiente();
            await Validar();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or JsonException)
        {
            // Si falla el refresco, el mensaje anterior ya le avisó al usuario.
        }
    }
}
