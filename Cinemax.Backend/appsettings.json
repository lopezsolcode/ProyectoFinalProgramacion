{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "Origenes": [ "https://tpprogramacion.runasp.net" ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "SalaLayout": {
    "Filas": 16,
    "Bloques": [ 4, 11, 4 ],
    "AnchoPasillo": 1,
    "UltimaFilaSinBloqueCentral": true,
    "UltimaFilaAccesibles": [ 1, 2, 3, 17, 18, 19 ]
  },
  "Funciones": { "MargenLimpiezaMinutos": 15 },
  "Ventas": {
    "MinutosVencimiento": 15,
    "MaxButacasPorVenta": 10
  },
  "PasarelaSimulada": { "Modo": "SegunCentavos" }
}